# Copy this file to .env and fill in your own values.
# Never commit the real .env file. Variable names only, no credentials.

# Required for AI explanations. Get a key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Model used for explanations and cited answers.
DEEPSEEK_MODEL=deepseek-flash

# DeepSeek-compatible API endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
